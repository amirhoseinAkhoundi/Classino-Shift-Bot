# Copy this file to .env and fill in real values.
# NEVER commit a real .env file.

# Required: Bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF_your_new_token_here

# Required: Target group chat ID (use /chatid in the group)
GROUP_CHAT_ID=-100xxxxxxxxxx

# Optional: Separate group for problem/help messages (defaults to GROUP_CHAT_ID if empty)
OPS_GROUP_ID=

# Comma-separated Telegram user IDs allowed to post schedules.
# If empty, SCHEDULE_ROLES are used instead.
SCHEDULE_SENDER_IDS=123456789

# Roles allowed to post schedules when SCHEDULE_SENDER_IDS is empty
SCHEDULE_ROLES=shift_manager,supervisor,bot_manager

# Minimum number of valid parsed lines to treat a message as a schedule
MIN_PARSED_LINES=5

# SQLite database path
DB_PATH=data/bot.db

# Optional: local proxy (usually not needed on servers outside Iran)
# PROXY_URL=socks5://127.0.0.1:10808
